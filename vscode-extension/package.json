{
  "name": "marev-ai-agent",
  "displayName": "MAREV: AI Function Identifier & Reverse Engineering Agent",
  "description": "Deduce semantic function names, C signatures, argument types, and explanations for stripped C and Assembly code using embedded AI agents.",
  "version": "0.1.0",
  "publisher": "marev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:marev.identifyFunction",
    "onCommand:marev.openSidebar",
    "onView:marev.sidebar"
  ],
  "contributes": {
    "commands": [
      {
        "command": "marev.identifyFunction",
        "title": "MAREV: Identify Function with AI Agent",
        "category": "MAREV"
      },
      {
        "command": "marev.openSidebar",
        "title": "MAREV: Open AI Function Identifier Sidebar",
        "category": "MAREV"
      },
      {
        "command": "marev.renameFunction",
        "title": "MAREV: Rename Function in File",
        "category": "MAREV"
      },
      {
        "command": "marev.insertDocumentation",
        "title": "MAREV: Insert Doxygen / C Signature",
        "category": "MAREV"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "marev.identifyFunction",
          "group": "marev@1",
          "when": "editorTextFocus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "marev.identifyFunction",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "marev-sidebar-view",
          "title": "MAREV AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "marev-sidebar-view": [
        {
          "type": "webview",
          "id": "marev.sidebar",
          "name": "AI Function Identifier"
        }
      ]
    },
    "configuration": {
      "title": "MAREV AI Function Identifier",
      "properties": {
        "marev.provider": {
          "type": "string",
          "enum": [
            "gemini",
            "ollama"
          ],
          "default": "gemini",
          "description": "Active LLM provider for reverse-engineering function semantics."
        },
        "marev.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key. If empty, checks GEMINI_API_KEY environment variable."
        },
        "marev.geminiModel": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Google Gemini model identifier (e.g. gemini-2.5-flash, gemini-1.5-pro)."
        },
        "marev.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Local Ollama HTTP endpoint."
        },
        "marev.ollamaModel": {
          "type": "string",
          "default": "qwen2.5-coder:latest",
          "description": "Local Ollama model name (e.g. qwen2.5-coder:latest, deepseek-coder:6.7b)."
        },
        "marev.autoExpandContext": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect and expand selection to full enclosing function boundaries."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
